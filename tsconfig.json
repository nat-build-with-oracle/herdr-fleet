{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": [
      "bun",
      "vite/client"
    ]
  },
  "include": [
    "web/console/**/*",
    "web/compare/**/*",
    "web/shared/**/*",
    "*.ts",
    "*.tsx",
    "vite.config.ts"
  ],
  "exclude": [
    "web/dist",
    "node_modules"
  ]
}
